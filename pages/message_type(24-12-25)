<script>
    $(document).ready(function() {
        $('#whatsapp_toggle').on('change', function() {
            let status = $('#whatsapp_toggle').is(':checked') ? 1 : 0;
            //  console.log(status);
            $.ajax({
                url: "/ajax/service/message_type_services.php",
                type: 'POST',
                dataType: 'json',
